        "html": "=<div style=\"font-family: Arial; line-height:1.6\">\n  <h2>📊 Pharma Competitive Intelligence Report</h2>\n\n  <p><b>Therapeutic Area:</b> {{ $('⚙️ Configuration').item.json.drug_keywords }}</p>\n\n  <p><b>Generated:</b> {{ $now.format('DD MMM YYYY') }}</p>\n\n  <hr>\n\n  <pre style=\"white-space: pre-wrap; font-family: Arial;\">\n{{ $json.report }}\n  </pre>\n\n  <hr>\n\n  <p style=\"font-size:12px; color:gray;\">\n    This email was sent automatically via n8n\n  </p>\n</div>",
        "options": {}
