      "id": "31faec74-be3c-4f44-9e23-e1673c593269",
      "name": "📰 NewsAPI — Competitor News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "// Process ClinicalTrials data\nconst trialsRaw = $input.first().json;\nconst studies = trialsRaw.studies || [];\n\nconst processed = studies.map(s => {\n  const p = s.protocolSection || {};\n  const id = p.identificationModule || {};\n  const status = p.statusModule || {};\n  const sponsor = p.sponsorCollaboratorsModule || {};\n  const design = p.designModule || {};\n\n  return {\n    nct_id: id.nctId || 'N/A',\n    title: id.briefTitle || 'N/A',\n    sponsor: (sponsor.leadSponsor || {}).name || 'N/A',\n    phase: (design.phases || []).join(', ') || 'N/A',\n    status: status.overallStatus || 'N/A',\n    start_date: status.startDateStruct?.date || 'N/A',\n    completion_date: status.primaryCompletionDateStruct?.date || 'N/A'\n  };\n});\n\n// Filter only competitor trials\nconst competitors = $('⚙️ Configuration').first().json.competitor_companies.split(',');\nconst competitorTrials = processed.filter(t =>\n  competitors.some(c => t.sponsor.toLowerCase().includes(c.trim().toLowerCase()))\n);\n\nreturn [{ json: { \n  all_trials: processed, \n  competitor_trials: competitorTrials,\n  total_count: processed.length,\n  competitor_count: competitorTrials.length,\n  fetch_date: new Date().toISOString().split('T')[0]\n}}];"
      },
      "id": "2323f368-e50a-4a09-9dab-751075f6fc6d",
      "name": "🔄 Process Trial Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "// Process FDA adverse events\nconst fdaRaw = $input.first().json;\nconst results = fdaRaw.results || [];\n\nconst summary = results.slice(0, 10).map(e => {\n  const drugs = (e.patient?.drug || []).slice(0, 3).map(d => \n    d.openfda?.brand_name?.[0] || d.medicinalproduct || 'Unknown'\n  );\n  const reactions = (e.patient?.reaction || []).slice(0, 3).map(r => r.reactionmeddrapt || 'Unknown');\n  return {\n    report_id: e.safetyreportid,\n    receive_date: e.receivedate,\n    drugs_involved: drugs.join(', '),\n    reactions: reactions.join(', '),\n    serious: e.serious === '1' ? 'Yes' : 'No'\n  };\n});\n\nreturn [{ json: {\n  adverse_event_sample: summary,\n  total_results: fdaRaw.meta?.results?.total || 0,\n  fetch_date: new Date().toISOString().split('T')[0]\n}}];"
      },
      "id": "1c20709e-89bc-4f66-bc6b-7afcd371c899",
      "name": "🔄 Process FDA Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "// Process competitor news\nconst newsRaw = $input.first().json;\nconst articles = newsRaw.articles || [];\n\nconst headlines = articles.slice(0, 8).map(a => ({\n  title: a.title,\n  source: a.source?.name || 'Unknown',\n  published: a.publishedAt?.split('T')[0] || 'N/A',\n  url: a.url,\n  description: a.description || ''\n}));\n\nreturn [{ json: {\n  news_headlines: headlines,\n  total_articles: newsRaw.totalResults || 0,\n  fetch_date: new Date().toISOString().split('T')[0]\n}}];"
      },
      "id": "f28113b6-a6e6-4259-ad3f-8239e5813b8a",
      "name": "🔄 Process News Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        480
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "numberInputs": 3,
        "options": {}
      },
      "id": "1fa2a7f6-09ea-42c0-9b39-475503afa650",
      "name": "🔗 Merge All Intel",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        480,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "// ✅ STEP 1: Get input (ONLY ONCE)\nconst raw = $input.first().json;\n\n// ✅ STEP 2: Extract data (ONLY ONCE)\nconst trialsData = raw.all_trials || [];\nconst fdaData = [];\nconst newsData = [];\n\n// ✅ STEP 3: Config\nconst config = {\n  therapeutic_area: \"oncology\",\n  drug_keywords: \"cancer treatment\"\n};\n\n// ✅ STEP 4: Date\nconst today = new Date().toLocaleDateString('en-IN', { dateStyle: 'long' });\n\n// ✅ STEP 5: Build report\nlet report = `# 📊 Pharma Competitive Intelligence Report\\n\\n`;\n\nreport += `**Therapeutic Area:** ${config.therapeutic_area.toUpperCase()}\\n`;\nreport += `**Generated:** ${today}\\n`;\nreport += `**Keywords:** ${config.drug_keywords}\\n\\n---\\n\\n`;\n\nreport += `## 🧪 Clinical Trials (${trialsData.length})\\n`;\n\ntrialsData.slice(0,5).forEach(t => {\n  report += `- ${t.title || 'N/A'} (${t.phase || 'N/A'})\\n`;\n});\n\n// ✅ STEP 6: Return\nreturn [\n  {\n    json: { report }\n  }\n];"
      },
      "id": "f36c79cb-d491-4c52-afde-0f5a05f27245",
      "name": "📊 Compile Intelligence Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        272
      ]
    },
