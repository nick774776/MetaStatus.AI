    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const articlesRaw = $json?.PubmedArticleSet?.PubmedArticle || [];\nconst articles = Array.isArray(articlesRaw) ? articlesRaw : [articlesRaw];\n\nconst results = articles.map(article => {\n  let abstractRaw = article?.MedlineCitation?.Article?.Abstract?.AbstractText || \"\";\n\n  let abstractText = Array.isArray(abstractRaw)\n    ? abstractRaw.map(a => (typeof a === \"object\" ? a._ : a)).join(\" \")\n    : abstractRaw;\n\n  return {\n    source: \"PubMed\",\n    pmid: article?.MedlineCitation?.PMID?._ || article?.MedlineCitation?.PMID || \"\",\n    title: article?.MedlineCitation?.Article?.ArticleTitle || \"\",\n    abstract: abstractText,\n    journal: article?.MedlineCitation?.Article?.Journal?.Title || \"\",\n    year:\n      article?.MedlineCitation?.Article?.ArticleDate?.[0]?.Year ||\n      article?.MedlineCitation?.DateCompleted?.Year ||\n      \"\"\n  };\n});\n\n// ⚠️ RETURN ONLY ONE OBJECT (IMPORTANT)\nreturn {\n  json: { results }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
